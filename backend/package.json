{
  "name": "agent-adam-backend",
  "version": "1.6.0",
  "description": "SilverTech Agent Adam — AI Voice Assistant for Seniors. Fastify + Prisma + pgvector + Redis + BullMQ backend.",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "build": "npx prisma generate",
    "test": "node --test tests/**/*.test.js",
    "lint": "echo 'ESLint not configured yet'"
  },
  "keywords": [
    "senior-care",
    "voice-assistant",
    "ai",
    "fastify",
    "prisma",
    "bullmq"
  ],
  "author": "SilverTech",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@fastify/compress": "8.0.1",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "12.0.1",
    "@fastify/jwt": "9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/swagger": "9.5.0",
    "@fastify/swagger-ui": "5.2.2",
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.10",
    "chromadb": "1.10.5",
    "fastify": "5.2.1",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "stripe": "17.5.0",
    "twilio": "5.4.0"
  },
  "devDependencies": {
    "pino-pretty": "13.0.0",
    "prisma": "6.2.1"
  },
  "packageManager": "pnpm@9.15.9"
}
