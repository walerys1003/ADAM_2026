# ─────────────────────────────────────────────────────────────────
# Agent Adam — Environment Variables (Example)
# SilverTech | June 2026
# Copy to .env and fill in real values for local development
# ─────────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# ── Database (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql://adam:adam_dev_2026@localhost:5432/agent_adam

# ── Redis (BullMQ + Cache) ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=24h

# ── CORS ──
CORS_ORIGINS=http://localhost:5060,http://localhost:3000,https://*.silvertech.ai

# ── Rate Limiting ──
RATE_LIMIT_MAX=100
VOICE_RATE_LIMIT=10
VOICE_MAX_CONCURRENCY=2

# ── AI / Voice Pipeline ──
# Deepgram (STT — speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3

# Google Gemini (LLM)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (TTS — text-to-speech)
OPENAI_API_KEY=your-openai-api-key
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# ── Twilio (Voice Calls) ──
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+48123456789

# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── SendGrid (Email) ──
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@silvertech.ai

# ── SMS (Twilio) ──
SMS_ENABLED=false

# ── RAG / Embeddings ──
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.6

# ── Guardrails ──
GUARDRAILS_STRICT=false
GUARDRAILS_MAX_TOKENS=500

# ── Semafor ──
SEMAFOR_AUTO_ESCALATE=false
MAX_CONVERSATION_DURATION=300

# ── Data Retention ──
DATA_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30

# ── Feature Flags (development: all enabled) ──
FEATURE_VOICE_WEBSOCKET=true
FEATURE_RAG_RETRIEVAL=true
FEATURE_GUARDRAILS=true
FEATURE_COST_TRACKING=true
FEATURE_HEALTH_CONNECT=true
FEATURE_MARKETPLACE=true
FEATURE_SOS_ESCALATION=true
FEATURE_WEEKLY_REPORTS=true
FEATURE_LLM_MOCK_MODE=true
FEATURE_VOICE_MOCK_MODE=true
