# =============================================================================
# Agent Adam Nginx Reverse Proxy
# =============================================================================
# Handles:
# - SSL termination (TLS 1.3)
# - Static asset serving (Flutter web build)
# - API reverse proxy to backend
# - WebSocket upgrade for voice calls
# - Rate limiting
# - Security headers
# =============================================================================

FROM nginx:1.27-alpine

# Install envsubst for config templating
RUN apk add --no-cache curl tzdata

# Remove default Nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf \
           /etc/nginx/nginx.conf

# Copy custom configuration
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/nginx/conf.d/agent-adam.conf /etc/nginx/conf.d/agent-adam.conf

# Copy Flutter web build (built separately, mounted at build time)
COPY build/web /usr/share/nginx/html

# Create directories for SSL certs (mounted at runtime)
RUN mkdir -p /etc/nginx/ssl /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx

# Switch to nginx user
USER nginx

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
